generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dosen {
  id_user    BigInt     @id
  nip        String?    @db.VarChar
  nama       String?    @db.VarChar
  email      String?    @db.VarChar
  no_telepon String?    @db.VarChar
  jurusan    String?    @db.VarChar
  user       users      @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  kelas      kelas[]
  lowongan   lowongan[]
}

model mahasiswa {
  id_user     BigInt        @id
  nrp         String?       @db.VarChar
  nama        String?       @db.VarChar
  email       String?       @db.VarChar
  no_telepon  String?       @db.VarChar
  jurusan     String?       @db.VarChar
  angkatan    String?       @db.VarChar
  semester    Int?
  dokumen_url String?
  asistensi   asistensi[]
  user        users         @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  notifikasi  notifikasi[]
  pendaftaran pendaftaran[]
}

model kelas {
  id_kelas    Int         @id @default(autoincrement())
  id_mk       Int
  nama_kelas  String?     @db.VarChar
  hari        String?     @db.VarChar
  jam_mulai   DateTime?   @db.Time(6)
  jam_selesai DateTime?   @db.Time(6)
  id_dosen    BigInt?
  dosen       dosen?      @relation(fields: [id_dosen], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  mata_kuliah mata_kuliah @relation(fields: [id_mk], references: [id_mk], onDelete: NoAction, onUpdate: NoAction)
  lowongan    lowongan[]
}

model lowongan {
  id_lowongan               Int                  @id @default(autoincrement())
  id_kelas                  Int
  id_dosen                  BigInt
  tahun_ajaran              String?              @db.VarChar
  jumlah_asisten            Int?
  persyaratan               String?
  honor                     Decimal?             @db.Decimal
  tanggal_mulai_pendaftaran DateTime?            @db.Timestamp(6)
  tanggal_akhir_pendaftaran DateTime?            @db.Timestamp(6)
  tanggal_mulai_kontrak     DateTime?            @db.Timestamp(6)
  tanggal_akhir_kontrak     DateTime?            @db.Timestamp(6)
  status                    lowongan_status_enum @default(aktif)
  asistensi                 asistensi[]
  dosen                     dosen                @relation(fields: [id_dosen], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  kelas                     kelas                @relation(fields: [id_kelas], references: [id_kelas], onDelete: NoAction, onUpdate: NoAction)
  notifikasi                notifikasi[]
  pendaftaran               pendaftaran[]
}

model mata_kuliah {
  id_mk      Int     @id @default(autoincrement())
  kode_mk    String? @db.VarChar
  nama_mk    String? @db.VarChar
  jumlah_sks Int?
  kelas      kelas[]
}

model notifikasi {
  id_notifikasi Int                     @id @default(autoincrement())
  id_lowongan   Int?
  id_mahasiswa  BigInt?
  channel       notifikasi_channel_enum @default(website)
  isi_pesan     String?
  tanggal_kirim DateTime?               @default(now()) @db.Timestamp(6)
  lowongan      lowongan?               @relation(fields: [id_lowongan], references: [id_lowongan], onDelete: NoAction, onUpdate: NoAction)
  mahasiswa     mahasiswa?              @relation(fields: [id_mahasiswa], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

model pendaftaran {
  id_pendaftaran     Int                      @id @default(autoincrement())
  id_lowongan        Int
  id_mahasiswa       BigInt
  status_pendaftaran status_pendaftaran_enum? @default(pending)
  tanggal_daftar     DateTime?                @default(now()) @db.Timestamp(6)
  lowongan           lowongan                 @relation(fields: [id_lowongan], references: [id_lowongan], onDelete: NoAction, onUpdate: NoAction)
  mahasiswa          mahasiswa                @relation(fields: [id_mahasiswa], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id_user       BigInt         @id @default(autoincrement())
  email         String         @unique @db.VarChar
  password_hash String
  role          user_role_enum @default(mahasiswa)
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  updated_at    DateTime?      @default(now()) @db.Timestamp(6)
  dosen         dosen?
  mahasiswa     mahasiswa?
}

model asistensi {
  id_asistensi    Int                   @id @default(autoincrement())
  id_lowongan     Int
  id_mahasiswa    BigInt
  tanggal_mulai   DateTime              @db.Timestamp(6)
  tanggal_selesai DateTime              @db.Timestamp(6)
  status          asistensi_status_enum @default(aktif)
  created_at      DateTime              @default(now()) @db.Timestamp(6)
  updated_at      DateTime              @default(now()) @db.Timestamp(6)
  lowongan        lowongan              @relation(fields: [id_lowongan], references: [id_lowongan], onDelete: NoAction, onUpdate: NoAction, map: "fk_asistensi_lowongan")
  mahasiswa       mahasiswa             @relation(fields: [id_mahasiswa], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_asistensi_mahasiswa")
}

enum tipe_berkas_enum {
  transkrip
  krs
  surat_motivasi
  lainnya
}

enum notifikasi_channel_enum {
  email
  wa
  website
}

enum status_pendaftaran_enum {
  pending
  accepted
  rejected
}

enum user_role_enum {
  mahasiswa
  dosen
  admin
}

enum asistensi_status_enum {
  aktif
  selesai
  dibatalkan
}

enum jenis_notifikasi_enum {
  email
  whatsapp
  floater
}

enum lowongan_status_enum {
  aktif
  tutup
}
